#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
// #include <input/processors/report_rate_limit.dtsi>
#include "../pinctrl_spi.dtsi"

&spi0 {
    status = "okay";
    cs-gpios =  <&gpio1 12 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    compatible = "nordic,nrf-spim";

    trackball: trackball_paw3222@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <1500000>;
        irq-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <800>;
        // evt-type = <INPUT_EV_REL>;
        // x-input-code = <INPUT_REL_X>;
        // y-input-code = <INPUT_REL_Y>;
        force-awake;
    };
};

&listner_central {
    input-processors
        = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>
        , <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>
        , <&zip_xy_scaler 3 2>
        // , <&zip_report_rate_limit 8>
        ;
    scroller {
        layers = <1>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>
        , <&zip_xy_to_scroll_mapper>
        , <&zip_scroll_scaler 3 2>
        ;
    };
};

